PORT=5000
SUPERADMIN_EMAIL=admin@jobsheet.com
SUPERADMIN_PASSWORD=your_superadmin_password
SUPER_ADMIN_EMAIL=admin@jobsheet.com
SUPER_ADMIN_PASSWORD=your_superadmin_password

MYAPP_ROOT=SwordNexJobSheet
MYAPP_TENANT_ID=SwordNexJobSheet-plw76
MYAPP_KEY=your_firebase_api_key

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

EMAIL_USER=noreply@swordnex.com
EMAIL_PASS=your_email_password

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@swordnex.com
SMTP_PASS=your_smtp_password
SENDER_EMAIL=noreply@swordnex.com
SENDER_NAME=SwordNex JobSheet

WHATSAPP_META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_META_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PROVIDER=meta


# Comma-separated origins allowed to call the API (leave empty to allow all).
# Desktop (Electron) builds are always allowed.
ALLOWED_ORIGINS=http://localhost:5173

# Dev server only: run the daily subscription reminder job locally (emails real users if DB is live!)
# RUN_CRON_LOCALLY=true
# Block creating jobsheets/technicians/sub-users once a plan has expired (enable once renewals work)
# ENFORCE_SUBSCRIPTION_EXPIRY=true

# Shared SwordNex login: one email + password across the SwordNex apps (project-wide Firebase Auth).
# JOBSHEET_SHARED_LOGIN=true
# FB_WEB_API_KEY=<public web API key of the swordnex-sites Firebase project>
